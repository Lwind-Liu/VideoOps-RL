{"utterance_id": "utt_0011", "start_ms": 99000, "end_ms": 101000, "text": "<i>( music fades out )</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0012", "start_ms": 106850, "end_ms": 109102, "text": "THIS BLADE HAS A DARK PAST.", "language": "en", "speaker": null}
{"utterance_id": "utt_0013", "start_ms": 111498, "end_ms": 114803, "text": "IT HAS SHED MUCH\nINNOCENT BLOOD.", "language": "en", "speaker": null}
{"utterance_id": "utt_0014", "start_ms": 117844, "end_ms": 121550, "text": "<i>YOU'RE A FOOL FOR TRAVELING ALONE,</i>\n<i>SO COMPLETELY UNPREPARED.</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0015", "start_ms": 121550, "end_ms": 123110, "text": "YOU'RE LUCKY\nYOUR BLOOD'S STILL FLOWING.", "language": "en", "speaker": null}
{"utterance_id": "utt_0016", "start_ms": 124750, "end_ms": 125763, "text": "THANK YOU.", "language": "en", "speaker": null}
{"utterance_id": "utt_0017", "start_ms": 127050, "end_ms": 133444, "text": "SO... WHAT BRINGS YOU TO\nTHE LAND OF THE GATEKEEPERS?", "language": "en", "speaker": null}
{"utterance_id": "utt_0018", "start_ms": 134500, "end_ms": 137666, "text": "UM... I'M SEARCHING FOR SOMEONE.", "language": "en", "speaker": null}
{"utterance_id": "utt_0019", "start_ms": 137666, "end_ms": 141888, "text": "SOMEONE VERY DEAR?\nA KINDRED SPIRIT?", "language": "en", "speaker": null}
{"utterance_id": "utt_0020", "start_ms": 143000, "end_ms": 144770, "text": "A DRAGON.", "language": "en", "speaker": null}
{"utterance_id": "utt_0021", "start_ms": 148550, "end_ms": 151550, "text": "Shaman: <i>A DANGEROUS QUEST</i>\n<i>FOR A LONE HUNTER.</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0022", "start_ms": 151550, "end_ms": 152550, "text": "<i>( crows cawing )</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0023", "start_ms": 152550, "end_ms": 155679, "text": "Sintel: <i>I'VE BEEN ALONE FOR</i>\n<i>AS LONG AS I CAN REMEMBER.</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0024", "start_ms": 163000, "end_ms": 168500, "text": "( flies buzzing )", "language": "en", "speaker": null}
{"utterance_id": "utt_0025", "start_ms": 168500, "end_ms": 172000, "text": "<i>( crows cawing )</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0026", "start_ms": 174400, "end_ms": 176000, "text": "( thud! )", "language": "en", "speaker": null}
{"utterance_id": "utt_0027", "start_ms": 181308, "end_ms": 184445, "text": "- ( gasps )\n- ( dragon whimpers )", "language": "en", "speaker": null}
{"utterance_id": "utt_0028", "start_ms": 195000, "end_ms": 196000, "text": "Sintel: <i>SHHH.</i>", "language": "en", "speaker": null}
{"utterance_id": "utt_0029", "start_ms": 205000, "end_ms": 207000, "text": "- ( dragon screeches )\n- HEY, SHH, SHH.", "language": "en", "speaker": null}
{"utterance_id": "utt_0030", "start_ms": 207000, "end_ms": 210560, "text": "WE'RE ALMOST DONE, SHHH.", "language": "en", "speaker": null}
{"utterance_id": "utt_0031", "start_ms": 210560, "end_ms": 213302, "text": "HEY, SIT STILL!", "language": "en", "speaker": null}
{"utterance_id": "utt_0032", "start_ms": 228000, "end_ms": 230750, "text": "GOOD NIGHT, SCALES.", "language": "en", "speaker": null}
{"utterance_id": "utt_0033", "start_ms": 230750, "end_ms": 248000, "text": "♪♪♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0034", "start_ms": 249500, "end_ms": 253640, "text": "- ( chicken clucks )\n- Sintel: <i>GET HIM, SCALES!</i>\n<i>COME ON, GET HIM!</i>", "language": "en", "speaker": null}
