{"utterance_id": "utt_0055", "start_ms": 445338, "end_ms": 446911, "text": "I HAVE FAILED.", "language": "en", "speaker": null}
{"utterance_id": "utt_0056", "start_ms": 452412, "end_ms": 455492, "text": "YOU'VE ONLY FAILED TO SEE...", "language": "en", "speaker": null}
{"utterance_id": "utt_0057", "start_ms": 457304, "end_ms": 459990, "text": "THESE ARE DRAGON LANDS,\nSINTEL.", "language": "en", "speaker": null}
{"utterance_id": "utt_0058", "start_ms": 459990, "end_ms": 462008, "text": "YOU ARE CLOSER\nTHAN YOU KNOW.", "language": "en", "speaker": null}
