{"utterance_id": "utt_0089", "start_ms": 767000, "end_ms": 771777, "text": "♪ <i>CAN YOU TELL ME</i>\n<i>LOVE FROM PRIDE?</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0090", "start_ms": 774000, "end_ms": 780500, "text": "♪ <i>I HAVE BEEN WAITING</i>\n<i>ALL THIS TIME</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0091", "start_ms": 780500, "end_ms": 783500, "text": "♪ <i>FOR ONE TO WAKE ME</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0092", "start_ms": 783500, "end_ms": 787000, "text": "♪ <i>ONE TO CALL MINE</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0093", "start_ms": 787000, "end_ms": 790000, "text": "♪ <i>SO WHEN YOU'RE NEAR</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0094", "start_ms": 790000, "end_ms": 793130, "text": "♪ <i>ALL THAT YOU HOLD DEAR</i> ♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0095", "start_ms": 793130, "end_ms": 800000, "text": "♪ <i>DO YOU FEAR</i>\n<i>WHAT YOU WILL FIND?</i> ♪", "language": "en", "speaker": null}
