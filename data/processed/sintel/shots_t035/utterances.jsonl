{"utterance_id": "utt_0082", "start_ms": 720500, "end_ms": 747500, "text": "♪♪♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0083", "start_ms": 747500, "end_ms": 750300, "text": "♪ <i>COME TAKE MY JOURNEY</i> ♪", "language": "en", "speaker": null}
