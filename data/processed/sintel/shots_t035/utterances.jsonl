{"utterance_id": "utt_0049", "start_ms": 386111, "end_ms": 389600, "text": "- ( tiger growling )\n- ( Sintel screams )", "language": "en", "speaker": null}
{"utterance_id": "utt_0050", "start_ms": 389600, "end_ms": 390610, "text": "AAH!", "language": "en", "speaker": null}
{"utterance_id": "utt_0051", "start_ms": 393000, "end_ms": 420000, "text": "♪♪♪", "language": "en", "speaker": null}
{"utterance_id": "utt_0052", "start_ms": 420000, "end_ms": 422000, "text": "<i>( music fades out )</i>", "language": "en", "speaker": null}
