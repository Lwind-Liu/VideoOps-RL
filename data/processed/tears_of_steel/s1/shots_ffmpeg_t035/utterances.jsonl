{"utterance_id": "utt_0001", "start_ms": 3000, "end_ms": 4500, "text": "You're a jerk, Thom.", "language": "en", "speaker": null}
{"utterance_id": "utt_0002", "start_ms": 5000, "end_ms": 7000, "text": "Look Celia, we have to follow our passions;", "language": "en", "speaker": null}
{"utterance_id": "utt_0003", "start_ms": 7000, "end_ms": 10500, "text": "...you have your robotics, and I\njust want to be awesome in space.", "language": "en", "speaker": null}
{"utterance_id": "utt_0004", "start_ms": 10800, "end_ms": 14000, "text": "Why don't you just admit that\nyou're freaked out by my robot hand?", "language": "en", "speaker": null}
{"utterance_id": "utt_0005", "start_ms": 14500, "end_ms": 16000, "text": "I'm not freaked out by- it's...", "language": "en", "speaker": null}
{"utterance_id": "utt_0006", "start_ms": 17000, "end_ms": 18000, "text": "...alright! Fine!", "language": "en", "speaker": null}
{"utterance_id": "utt_0007", "start_ms": 18000, "end_ms": 21000, "text": "I'm freaked out! I have nightmares\nthat I'm being chased...", "language": "en", "speaker": null}
{"utterance_id": "utt_0008", "start_ms": 21000, "end_ms": 22000, "text": "...by these giant robotic claws of death...", "language": "en", "speaker": null}
{"utterance_id": "utt_0009", "start_ms": 22200, "end_ms": 25000, "text": "\"Fourty years later\"\nWhatever, Thom. We're done.", "language": "en", "speaker": null}
{"utterance_id": "utt_0010", "start_ms": 30000, "end_ms": 33500, "text": "Robot's memory synced and locked!", "language": "en", "speaker": null}
{"utterance_id": "utt_0011", "start_ms": 41000, "end_ms": 43000, "text": "This is pretty freaky.", "language": "en", "speaker": null}
{"utterance_id": "utt_0012", "start_ms": 97000, "end_ms": 99000, "text": "Shouldn't you be down there?", "language": "en", "speaker": null}
{"utterance_id": "utt_0013", "start_ms": 111000, "end_ms": 113000, "text": "I heard you guys talking last night.", "language": "en", "speaker": null}
{"utterance_id": "utt_0014", "start_ms": 116000, "end_ms": 118000, "text": "It's not my fault, you know.", "language": "en", "speaker": null}
{"utterance_id": "utt_0015", "start_ms": 171000, "end_ms": 172000, "text": "Are you ready?", "language": "en", "speaker": null}
{"utterance_id": "utt_0016", "start_ms": 173000, "end_ms": 175000, "text": "Of course you're ready, you're a rockstar.", "language": "en", "speaker": null}
{"utterance_id": "utt_0017", "start_ms": 177000, "end_ms": 178000, "text": "How's it looking, Barley?", "language": "en", "speaker": null}
{"utterance_id": "utt_0018", "start_ms": 179000, "end_ms": 181000, "text": "We should have about ten minutes...", "language": "en", "speaker": null}
{"utterance_id": "utt_0019", "start_ms": 181500, "end_ms": 183000, "text": "Well that's perfect.", "language": "en", "speaker": null}
{"utterance_id": "utt_0020", "start_ms": 183500, "end_ms": 186500, "text": "We're on in one! All systems go!\nYeah you, go!", "language": "en", "speaker": null}
{"utterance_id": "utt_0021", "start_ms": 188000, "end_ms": 192000, "text": "Go! Move your asses! Go go go!", "language": "en", "speaker": null}
{"utterance_id": "utt_0022", "start_ms": 193000, "end_ms": 197000, "text": "I love it! Come on, go!", "language": "en", "speaker": null}
{"utterance_id": "utt_0023", "start_ms": 203000, "end_ms": 204000, "text": "That's nice.", "language": "en", "speaker": null}
{"utterance_id": "utt_0024", "start_ms": 204500, "end_ms": 205700, "text": "Nothing to worry about.", "language": "en", "speaker": null}
{"utterance_id": "utt_0025", "start_ms": 206000, "end_ms": 207000, "text": "Thom.", "language": "en", "speaker": null}
{"utterance_id": "utt_0026", "start_ms": 211000, "end_ms": 213000, "text": "There she is.", "language": "en", "speaker": null}
{"utterance_id": "utt_0027", "start_ms": 213500, "end_ms": 214500, "text": "Now.", "language": "en", "speaker": null}
{"utterance_id": "utt_0028", "start_ms": 215000, "end_ms": 216000, "text": "You love her.", "language": "en", "speaker": null}
{"utterance_id": "utt_0029", "start_ms": 217000, "end_ms": 218500, "text": "She is your passion!", "language": "en", "speaker": null}
{"utterance_id": "utt_0030", "start_ms": 220000, "end_ms": 221000, "text": "Be tender to her.", "language": "en", "speaker": null}
{"utterance_id": "utt_0031", "start_ms": 221500, "end_ms": 224500, "text": "Be honest! Eh- be tender.", "language": "en", "speaker": null}
{"utterance_id": "utt_0032", "start_ms": 225000, "end_ms": 228000, "text": "Remind her what love is.", "language": "en", "speaker": null}
{"utterance_id": "utt_0033", "start_ms": 272000, "end_ms": 275000, "text": "...and, action!", "language": "en", "speaker": null}
{"utterance_id": "utt_0034", "start_ms": 276500, "end_ms": 278000, "text": "Memory overwrite in progress!", "language": "en", "speaker": null}
{"utterance_id": "utt_0035", "start_ms": 279000, "end_ms": 281000, "text": "You're a jerk, Thom!", "language": "en", "speaker": null}
{"utterance_id": "utt_0036", "start_ms": 282500, "end_ms": 285000, "text": "Ohp- Sorry! Sorry.", "language": "en", "speaker": null}
{"utterance_id": "utt_0037", "start_ms": 296000, "end_ms": 297000, "text": "Look Celia.", "language": "en", "speaker": null}
{"utterance_id": "utt_0038", "start_ms": 298000, "end_ms": 300000, "text": "We have to follow our passions.", "language": "en", "speaker": null}
{"utterance_id": "utt_0039", "start_ms": 301000, "end_ms": 303000, "text": "You have your robotics...", "language": "en", "speaker": null}
{"utterance_id": "utt_0040", "start_ms": 305000, "end_ms": 308000, "text": "...and I just want to be awesome in space.", "language": "en", "speaker": null}
{"utterance_id": "utt_0041", "start_ms": 319000, "end_ms": 321000, "text": "Okay, they're coming. Two minutes left!", "language": "en", "speaker": null}
{"utterance_id": "utt_0042", "start_ms": 323000, "end_ms": 324000, "text": "Speed it up, Thom!", "language": "en", "speaker": null}
{"utterance_id": "utt_0043", "start_ms": 325000, "end_ms": 326000, "text": "Vivacissimo!", "language": "en", "speaker": null}
{"utterance_id": "utt_0044", "start_ms": 327000, "end_ms": 330000, "text": "Why don't you just admit that you're\nfreaked out by my robot hand?", "language": "en", "speaker": null}
{"utterance_id": "utt_0045", "start_ms": 336000, "end_ms": 339000, "text": "Listen Celia, I was young...", "language": "en", "speaker": null}
{"utterance_id": "utt_0046", "start_ms": 339500, "end_ms": 341000, "text": "...and a dick.", "language": "en", "speaker": null}
{"utterance_id": "utt_0047", "start_ms": 341000, "end_ms": 343000, "text": "But that's no reason to\ndestroy the world.", "language": "en", "speaker": null}
{"utterance_id": "utt_0048", "start_ms": 345000, "end_ms": 346000, "text": "Why does he do this?", "language": "en", "speaker": null}
{"utterance_id": "utt_0049", "start_ms": 346500, "end_ms": 348500, "text": "We already tried that one!", "language": "en", "speaker": null}
{"utterance_id": "utt_0050", "start_ms": 351500, "end_ms": 352500, "text": "Abort!", "language": "en", "speaker": null}
{"utterance_id": "utt_0051", "start_ms": 353000, "end_ms": 354000, "text": "Cut!", "language": "en", "speaker": null}
{"utterance_id": "utt_0052", "start_ms": 354000, "end_ms": 355000, "text": "Whoaaa!", "language": "en", "speaker": null}
{"utterance_id": "utt_0053", "start_ms": 359000, "end_ms": 360000, "text": "Whoaaa!", "language": "en", "speaker": null}
{"utterance_id": "utt_0054", "start_ms": 361000, "end_ms": 363000, "text": "Nooooo!", "language": "en", "speaker": null}
{"utterance_id": "utt_0055", "start_ms": 363000, "end_ms": 365000, "text": "You broke my heart.", "language": "en", "speaker": null}
{"utterance_id": "utt_0056", "start_ms": 366000, "end_ms": 367000, "text": "I know.", "language": "en", "speaker": null}
{"utterance_id": "utt_0057", "start_ms": 367000, "end_ms": 369000, "text": "You forgot me on earth.", "language": "en", "speaker": null}
{"utterance_id": "utt_0058", "start_ms": 369000, "end_ms": 370000, "text": "I know.", "language": "en", "speaker": null}
{"utterance_id": "utt_0059", "start_ms": 370500, "end_ms": 373000, "text": "I should just crush you.", "language": "en", "speaker": null}
{"utterance_id": "utt_0060", "start_ms": 376000, "end_ms": 377000, "text": "I'm-", "language": "en", "speaker": null}
{"utterance_id": "utt_0061", "start_ms": 387000, "end_ms": 388000, "text": "I'm sorry.", "language": "en", "speaker": null}
{"utterance_id": "utt_0062", "start_ms": 390000, "end_ms": 391000, "text": "Good ad-lib.", "language": "en", "speaker": null}
{"utterance_id": "utt_0063", "start_ms": 399000, "end_ms": 400500, "text": "Not my fault!", "language": "en", "speaker": null}
{"utterance_id": "utt_0064", "start_ms": 402000, "end_ms": 403000, "text": "This time.", "language": "en", "speaker": null}
{"utterance_id": "utt_0065", "start_ms": 408000, "end_ms": 409500, "text": "Quiet on set!", "language": "en", "speaker": null}
{"utterance_id": "utt_0066", "start_ms": 410000, "end_ms": 411000, "text": "We're out of time!", "language": "en", "speaker": null}
{"utterance_id": "utt_0067", "start_ms": 473000, "end_ms": 474000, "text": "Come on!", "language": "en", "speaker": null}
